# Telegram
BOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# GitHub (fine-grained PAT: Contents rw + Administration write-visibility-only, NO delete_repo)
GITHUB_TOKEN=

# Admin
ADMIN_TG_ID=

# Local LLM (Lite mode) — OpenAI-compatible endpoint, e.g. Ollama/vLLM
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:14b

# Quota auto-check thresholds (see docs/architecture)
AUTOCHECK_ENABLED=false
AUTOCHECK_FULL_THRESHOLD_PCT=60
AUTOCHECK_LITE_THRESHOLD_PCT=90
AUTOCHECK_LITE_HOURS_BEFORE_RESET=1
