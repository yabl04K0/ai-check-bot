# Telegram
BOT_TOKEN=
# Без ADMIN_TG_ID бот открыт ЛЮБОМУ, кто напишет ему в Telegram (см.
# app/bot/access_control.py) — он выполняет git commit, трогает GitHub и
# тратит платную квоту ИИ, поэтому заполнить это поле — не опция, а
# обязательный шаг для приватного использования.
ADMIN_TG_ID=

# ==== AI-провайдеры (не заполнять то, что не подключаешь) ====

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# Codex (OpenAI) — либо API-ключ, либо CLI-логин в аккаунт ChatGPT (пусто =
# режим CLI выключен, доступен только API-ключ). Кнопка "Войти" в Настройках
# → 🔌 Провайдеры ИИ запускает `<CODEX_CLI_PATH> login`.
OPENAI_API_KEY=
CODEX_CLI_PATH=

# Cursor — логинится через Cursor Agent CLI (`cursor-agent login`),
# токен обычно не хранится тут напрямую, см. docs/PROJECT_SPEC.md
CURSOR_AGENT_CLI_PATH=/usr/local/bin/cursor-agent

# Локальная LLM (Lite-режим) — OpenAI-совместимый endpoint
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:14b

# Доп. провайдеры — все через общий OpenAI-совместимый контракт (см.
# app/providers/openai_compatible.py), заводить только то, что реально
# используешь. *_MODEL — опциональный override модели по умолчанию.

# Gemini (Google) — https://ai.google.dev/gemini-api/docs/openai
GEMINI_API_KEY=
GEMINI_MODEL=

# DeepSeek — https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Grok (xAI) — https://docs.x.ai/docs/api-reference
GROK_API_KEY=
GROK_MODEL=

# Groq (LPU-инференс, очень низкая задержка) — https://console.groq.com/docs/openai
GROQ_API_KEY=
GROQ_MODEL=

# Mistral — https://docs.mistral.ai/api
MISTRAL_API_KEY=
MISTRAL_MODEL=

# OpenRouter (единый шлюз к десяткам моделей) — https://openrouter.ai/docs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# GitHub (fine-grained PAT: Contents rw + Administration write-visibility-only,
# NO delete_repo — см. docs/PROJECT_SPEC.md, ограничение на уровне кода)
GITHUB_TOKEN=

# Недельный бюджет токенов на провайдера — нужен только чтобы автопроверка
# (ниже) могла оценить % израсходованной квоты. Официального API учёта нет,
# это грубая оценка бота по собственным логам. Не заполнено = автопроверка
# по этому провайдеру не сработает (но остальной бот работает как обычно).
ANTHROPIC_WEEKLY_TOKEN_BUDGET=
OPENAI_WEEKLY_TOKEN_BUDGET=
GEMINI_WEEKLY_TOKEN_BUDGET=
DEEPSEEK_WEEKLY_TOKEN_BUDGET=
GROK_WEEKLY_TOKEN_BUDGET=
GROQ_WEEKLY_TOKEN_BUDGET=
MISTRAL_WEEKLY_TOKEN_BUDGET=
OPENROUTER_WEEKLY_TOKEN_BUDGET=

# Пороги автопроверки по квоте (см. docs/PROJECT_SPEC.md)
AUTOCHECK_ENABLED=false
AUTOCHECK_FULL_THRESHOLD_PCT=60
AUTOCHECK_LITE_THRESHOLD_PCT=90
AUTOCHECK_LITE_HOURS_BEFORE_RESET=1
